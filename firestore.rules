rules_version = '2';

// All writes go through Cloud Functions (Admin SDK bypasses these rules).
// Clients may only read their own, non-sensitive documents.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      // Encrypted birth data: server only.
      match /private/{doc} {
        allow read, write: if false;
      }

      match /chat/{msgId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Teaser-only reading documents; full content lives in a server-only subcollection.
    match /readings/{readingId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;

      match /full/{doc} {
        allow read, write: if false;
      }
    }

    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /matches/{matchId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Everything else (purchases, locks, rate limits, ...) is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
