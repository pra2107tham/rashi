{
  "name": "rashi-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --project unit",
    "test:integration": "firebase emulators:exec --only firestore --project demo-rashi \"vitest run --project integration\"",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions,firestore",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@googleapis/androidpublisher": "^42.1.0",
    "astronomy-engine": "^2.1.19",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "geo-tz": "^8.1.9",
    "luxon": "^3.7.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.31.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
